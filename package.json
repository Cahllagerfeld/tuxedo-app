{
	"name": "tuxedo",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "pnpm --filter @tuxedo/desktop dev",
		"build": "pnpm --filter @tuxedo/desktop build",
		"preview": "pnpm --filter @tuxedo/desktop preview",
		"check:watch": "pnpm --filter @tuxedo/desktop check:watch",
		"test:unit": "pnpm --filter @tuxedo/desktop test:unit",
		"test:unit:watch": "pnpm --filter @tuxedo/desktop test:unit:watch",
		"test": "pnpm test:unit && pnpm test:backend",
		"check:electron": "pnpm --filter @tuxedo/desktop check:electron",
		"check:boundaries": "pnpm --filter @tuxedo/desktop check:boundaries",
		"test:electron": "pnpm --filter @tuxedo/desktop test:electron",
		"test:electron:visible": "pnpm --filter @tuxedo/desktop test:electron:visible",
		"test:electron:dev": "pnpm --filter @tuxedo/desktop test:electron:dev",
		"package:macos": "pnpm --filter @tuxedo/desktop package:macos",
		"test:package": "pnpm --filter @tuxedo/desktop test:package",
		"check": "pnpm --filter @tuxedo/contracts check && pnpm --filter @tuxedo/desktop check",
		"test:backend": "pnpm --filter @tuxedo/contracts test && pnpm --filter @tuxedo/desktop test:backend",
		"lint": "prettier --check .",
		"format": "prettier --write ."
	},
	"license": "MIT",
	"devDependencies": {
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.1"
	},
	"packageManager": "pnpm@12.11.2"
}
