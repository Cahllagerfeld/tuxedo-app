{
	"name": "@tuxedo/desktop",
	"version": "0.1.0",
	"description": "",
	"type": "module",
	"scripts": {
		"dev": "vite --mode electron --host 127.0.0.1",
		"build": "vite build --mode electron",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && pnpm check:electron && pnpm check:boundaries",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"prepare": "svelte-kit sync || echo ''",
		"test:unit": "vitest --run",
		"test:unit:watch": "vitest",
		"test": "pnpm test:unit && pnpm test:backend",
		"check:electron": "tsc -p electron/tsconfig.json",
		"test:backend": "vitest run --config vitest.backend.config.ts",
		"check:boundaries": "node scripts/check-desktop-boundaries.mjs",
		"test:electron": "node scripts/test-electron.mjs",
		"test:electron:visible": "node scripts/test-electron.mjs --visible",
		"test:electron:dev": "node scripts/test-electron.mjs --dev",
		"package:macos": "node scripts/package-macos.mjs",
		"test:package": "node scripts/test-package.mjs"
	},
	"license": "MIT",
	"devDependencies": {
		"@effect/platform-node": "4.0.5",
		"@effect/vitest": "4.0.5",
		"@electron-forge/cli": "8.0.1",
		"@electron/asar": "4.3.1",
		"@fontsource-variable/figtree": "5.3.0",
		"@fontsource-variable/jetbrains-mono": "5.3.0",
		"@internationalized/date": "3.12.4",
		"@lucide/svelte": "1.61.0",
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/kit": "3.1.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"@tanstack/svelte-hotkeys": "0.16.0",
		"@tanstack/svelte-virtual": "3.13.47",
		"@types/node": "24.19.2",
		"@vitest/browser-playwright": "5.0.5",
		"bits-ui": "2.19.5",
		"cn": "0.5.0",
		"effect": "4.0.5",
		"electron": "45.0.0",
		"formsnap": "2.1.0",
		"mode-watcher": "1.1.0",
		"paneforge": "1.0.2",
		"playwright": "1.64.1",
		"shadcn-svelte": "1.7.0",
		"svelte": "5.57.2",
		"svelte-check": "4.7.7",
		"svelte-dnd-action": "0.9.80",
		"svelte-sonner": "1.2.1",
		"sveltekit-superforms": "3.0.0",
		"tailwind-variants": "3.3.1",
		"tailwindcss": "4.3.3",
		"tw-animate-css": "1.4.0",
		"typescript": "6.0.3",
		"vite": "8.3.5",
		"vite-plugin-electron": "1.1.2",
		"vitest": "5.0.5",
		"vitest-browser-svelte": "3.1.0"
	},
	"main": "dist-electron/main.js",
	"private": true,
	"dependencies": {
		"@tuxedo/backend": "workspace:*",
		"@tuxedo/contracts": "workspace:*"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
