{
	"name": "tuxedo",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "node scripts/turbo.mjs run dev",
		"build": "node scripts/turbo.mjs run build",
		"preview": "node scripts/turbo.mjs run preview",
		"check:watch": "node scripts/turbo.mjs run check:watch",
		"test:unit": "node scripts/turbo.mjs run test:unit",
		"test:unit:watch": "node scripts/turbo.mjs run test:unit:watch",
		"test": "pnpm test:unit && pnpm test:backend",
		"check:electron": "node scripts/turbo.mjs run check:electron",
		"check:boundaries": "node scripts/turbo.mjs run check:boundaries",
		"test:electron": "node scripts/turbo.mjs run test:electron",
		"test:electron:visible": "node scripts/turbo.mjs run test:electron:visible",
		"test:electron:dev": "node scripts/turbo.mjs run test:electron:dev",
		"package:macos": "node scripts/turbo.mjs run package:macos",
		"test:package": "node scripts/turbo.mjs run test:package",
		"check": "node scripts/turbo.mjs run check",
		"test:backend": "node scripts/turbo.mjs run test:backend",
		"lint": "node scripts/turbo.mjs run format:check",
		"format": "prettier --write .",
		"turbo": "node scripts/turbo.mjs",
		"format:check": "prettier --check ."
	},
	"license": "MIT",
	"devDependencies": {
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"turbo": "2.11.10"
	},
	"packageManager": "pnpm@12.11.2"
}
