{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"forceConsistentCasingInFileNames": true,
		"types": ["node"]
	},
	"include": ["./**/*.ts", "../src/lib/shared/desktop/**/*.ts"]
}
