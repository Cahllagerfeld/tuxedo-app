{
	"name": "tauri-app",
	"version": "0.1.0",
	"description": "",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && pnpm check:electron && pnpm check:boundaries",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"tauri": "tauri",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"prepare": "svelte-kit sync || echo ''",
		"test:unit": "vitest --run",
		"test:unit:watch": "vitest",
		"test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
		"test": "pnpm test:unit && pnpm test:rust",
		"dev:electron": "node scripts/electron-dev.mjs",
		"build:electron": "node scripts/electron-build.mjs",
		"check:electron": "tsc -p tsconfig.electron.json",
		"test:backend": "vitest run --config vitest.backend.config.ts",
		"check:boundaries": "node scripts/check-desktop-boundaries.mjs",
		"test:electron": "pnpm build && pnpm build:electron && node scripts/test-electron.mjs",
		"test:electron:dev": "pnpm build:electron && node scripts/test-electron-dev.mjs"
	},
	"license": "MIT",
	"dependencies": {
		"@tauri-apps/api": "^2.12.1",
		"@tauri-apps/plugin-dialog": "^2.8.1",
		"@tauri-apps/plugin-opener": "^2.7.0"
	},
	"devDependencies": {
		"@fontsource-variable/figtree": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.52.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/svelte-query": "^6.3.1",
		"@tauri-apps/cli": "^2.12.1",
		"@types/node": "^24.19.1",
		"@vitest/browser-playwright": "^4.1.11",
		"bits-ui": "^2.19.5",
		"clsx": "^2.1.1",
		"electron": "^44.6.0",
		"esbuild": "^0.28.2",
		"formsnap": "^2.0.1",
		"mode-watcher": "^1.1.0",
		"paneforge": "^1.0.2",
		"playwright": "^1.63.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"svelte-sonner": "^1.2.1",
		"sveltekit-superforms": "^2.31.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"vite": "^8.3.3",
		"vitest": "^4.1.11",
		"vitest-browser-svelte": "^3.1.0",
		"zod": "^4.6.5"
	},
	"packageManager": "pnpm@12.7.0"
}
