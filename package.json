{
	"name": "tuxedo",
	"version": "0.1.0",
	"description": "",
	"type": "module",
	"scripts": {
		"dev": "vite --mode electron --host 127.0.0.1",
		"build": "vite build --mode electron",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && pnpm check:electron && pnpm check:boundaries",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"prepare": "svelte-kit sync || echo ''",
		"test:unit": "vitest --run",
		"test:unit:watch": "vitest",
		"test": "pnpm test:unit && pnpm test:backend",
		"check:electron": "tsc -p electron/tsconfig.json",
		"test:backend": "vitest run --config vitest.backend.config.ts",
		"check:boundaries": "node scripts/check-desktop-boundaries.mjs",
		"test:electron": "pnpm build && node scripts/test-electron.mjs",
		"test:electron:dev": "pnpm build && node scripts/test-electron.mjs --dev",
		"package:macos": "pnpm build && node scripts/package-macos.mjs",
		"test:package": "pnpm package:macos && node scripts/test-package.mjs"
	},
	"license": "MIT",
	"devDependencies": {
		"@electron-forge/cli": "^8.0.1",
		"@electron/asar": "^4.3.1",
		"@fontsource-variable/figtree": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.54.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.19.1",
		"@vitest/browser-playwright": "^5.0.3",
		"bits-ui": "^2.19.5",
		"cn": "^0.4.0",
		"electron": "^44.7.0",
		"formsnap": "^2.0.1",
		"mode-watcher": "^1.1.0",
		"playwright": "^1.64.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"svelte-sonner": "^1.2.1",
		"sveltekit-superforms": "^2.31.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"vite": "^8.3.4",
		"vite-plugin-electron": "^1.1.2",
		"vitest": "^5.0.3",
		"vitest-browser-svelte": "^3.1.0",
		"zod": "^4.6.5"
	},
	"packageManager": "pnpm@12.10.1",
	"main": "dist-electron/main.js"
}
